<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_matte_dark"
    android:padding="16dp">

    <!-- Top Telemetry Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="36sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="29 EYLÜL 2026"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Tesla Hardware Telemetry Capsule -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:background="@drawable/bg_telemetry_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvBatteryVolt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.18V • 32.4°C"
                android:textColor="@color/accent_amber"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRamUsage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAM: 9.4GB / 16GB"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hardware Camera Auto Calibration Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCameraCalibrator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/bg_card_titanium"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DONANIM KAMERA KALİBRATÖRÜ"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvSensorStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● SENSÖR AKTİF"
                    android:textColor="@color/accent_green"
                    android:textSize="9sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Real-time Lux & Exposure Readout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLuxReading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ortam Işığı: 340 lx"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tvAutoParams"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto ISO 100 • 1/120s • EV +0.0"
                        android:textColor="@color/accent_cyan"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnLaunchCamera"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="KAMERA"
                    android:textColor="@color/bg_matte_dark"
                    android:backgroundTint="@color/accent_amber"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-black"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Search Box -->
    <EditText
        android:id="@+id/etSearchApps"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_search_input"
        android:hint="@string/search_hint"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_mono"
        android:textSize="12sp"
        android:paddingHorizontal="14dp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:layout_marginBottom="12dp" />

    <!-- Real Installed Apps Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
